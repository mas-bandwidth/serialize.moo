; The serialize.moo roadmap: the data ROADMAP.md is generated from, in the shape of
; mas-bandwidth/schema's and mas-bandwidth/moo's docs/roadmap.sexp (one restricted
; S-expression; data, never evaluated). ROADMAP.md is rendered by tools/roadmap/render.lisp
; (vendored from mas-bandwidth/moo): edit this file, then `make roadmap`; `make roadmap-check`
; fails when the committed page is not what this data renders. Never edit ROADMAP.md by hand.
;
; The rows are the features of the C++ reference (mas-bandwidth/serialize, serialize.h,
; STANDARD.md 1.1) and what moo needs besides. A cell is ✅ only when every task under it is
; :done, and a :done task names its evidence (the test that holds it).
(:schema 1 :root "serialize-moo/roadmap"
 :page (:title "serialize.moo roadmap"
        :roadmaps ("fields" "numbers" "checks")
        :closing ((:title "About this page" :text ("Each table lists features of the C++ reference or of the moo port: ✅ is built and tested, with the test named in the source data; ❌ is not yet, with the reason in the source data."))))
 :nodes
((:id "serialize-moo/roadmap" :type :work-set :children ("fields" "numbers" "checks"))
  (:id "fields" :type :roadmap :title "Every field kind of the C++ reference"
   :text ("The operations of STANDARD.md format 1.1 as serialize.h and serialize.go carry them, on all three streams (write, read, measure), byte for byte and refusal for refusal.")
   :rows
   (("bits" "bits and bits64, 1 to 64 bits")
    ("bool" "bool")
    ("uint" "uint8, uint16, uint32 and uint64")
    ("uint128" "uint128")
    ("int" "int, ranged int32")
    ("int64" "int64, ranged")
    ("int128" "int128, ranged")
    ("fixed" "fixed point, 64-bit and 128-bit storage (Q112.16, Q64.64)")
    ("int-relative" "int_relative")
    ("float" "float, every binary32 pattern")
    ("double" "double, every binary64 pattern")
    ("compressed-float" "compressed_float in float32 arithmetic")
    ("precomputed" "compressed_float precomputed, and compressedFloatParams")
    ("bytes" "bytes")
    ("string" "string, UTF-8 checked on read")
    ("wstring" "wstring, UTF-16 code units")
    ("align" "align")
    ("object" "object, and sequences of every operation")
    ("measure" "The measure stream, a bound at every start position")
    ("loops" "Continue and Until end on hostile data")
    ("bitpacker" "BitWriter and BitReader")
    ("read-write-forms" "read_ and write_ convenience variants (C++ only; STANDARD.md makes them optional)")
    ("compile-time" "Compile-time ranged forms (C++ templates)"))
   :columns (("moo" "serialize.moo"))
   :cells
   (("bits" "moo" "fields/bits")
    ("bool" "moo" "fields/bool")
    ("uint" "moo" "fields/uint")
    ("uint128" "moo" "fields/uint128")
    ("int" "moo" "fields/int")
    ("int64" "moo" "fields/int64")
    ("int128" "moo" "fields/int128")
    ("fixed" "moo" "fields/fixed")
    ("int-relative" "moo" "fields/int-relative")
    ("float" "moo" "fields/float")
    ("double" "moo" "fields/double")
    ("compressed-float" "moo" "fields/compressed-float")
    ("precomputed" "moo" "fields/precomputed")
    ("bytes" "moo" "fields/bytes")
    ("string" "moo" "fields/string")
    ("wstring" "moo" "fields/wstring")
    ("align" "moo" "fields/align")
