  (:id "numbers" :type :roadmap :title "moo numbers on an IEEE wire"
   :text ("moo has no float, double or 64-bit integer: a number is Q48.16 fixed point. These are the bridges.")
   :rows
   (("wide" "Uint64, Int64, Uint128 and Int128 with serialize.go's arithmetic")
    ("boundary" "The float boundary: one exact rule, ties to even, a finite value past every moo number refused on read")
