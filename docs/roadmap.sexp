    ("softfloat" "Float32 arithmetic emulated bit for bit")
    ("float32-parse" "Float32.parse rounds a decimal once, as strtof")
    ("fixed-number" "serializeFixedNumber: a moo number as Q48.16 on the wire, exact"))
